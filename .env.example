# Caminho base do projeto na sua máquina local (Raiz da pasta 'Codigo')
# Ex: C:\Users\SeuUsuario\Documentos\CMTT\Codigo
BASE_DIR_PROJETO=C:\caminho\para\o\seu\projeto\Codigo

# Caminho para a rede interna da secretaria (Caso aplicável para backup/raspagem dupla)
# Ex: Z:\PASTACOMPARTILHADA - Documentos\03_b_Conselho_Municipal_de_Transito_e_Transporte_CMTT
DIR_REDE_INTERNA=C:\caminho\para\a\rede\interna